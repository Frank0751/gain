# Environment Variables for GAIN Website
# Copy this file to .env.local and fill in your values

# Database (optional - only needed if using Prisma)
# DATABASE_URL="file:./dev.db"

# Paystack (for donation integration - not yet implemented)
# PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Email (for form notifications - not yet implemented)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"

# Site URL (update for production)
# NEXT_PUBLIC_SITE_URL="https://gainghana.org"
